{
  "name": "telegram-group-manager",
  "version": "1.0.0",
  "description": "Desktop application for managing Telegram group members",
  "main": "dist/main/main.js",
  "author": "Your Name",
  "license": "MIT",
  "private": true,
  "scripts": {
    "clean": "rimraf dist release",
    "build": "tsc",
    "build:watch": "tsc -w",
    "copy-assets": "node copy-assets.js",
    "postbuild": "npm run copy-assets",
    "start": "npm run build && npm run copy-assets && electron .",
    "dev": "concurrently \"npm run build:watch\" \"npm run copy-assets && cross-env NODE_ENV=development electron .\"",
    "dist": "npm run build && npm run copy-assets && electron-builder",
    "dist:win": "npm run build && npm run copy-assets && electron-builder --win",
    "dist:mac": "npm run build && npm run copy-assets && electron-builder --mac",
    "dist:linux": "npm run build && npm run copy-assets && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {},
  "devDependencies": {
    "teleproto": "1.223.1",
    "grammy": "1.21.1",
    "dotenv": "16.4.5",
    "electron-log": "5.1.1",
    "electron-store": "8.1.0",
    "@types/node": "20.11.16",
    "typescript": "5.3.3",
    "electron": "28.2.0",
    "electron-builder": "24.13.3",
    "concurrently": "8.2.2",
    "cross-env": "7.0.3",
    "rimraf": "5.0.5",
    "copyfiles": "2.4.1",
    "ts-node": "10.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  },
  "packageManager": "yarn@1.22.21",
  "build": {
    "appId": "com.yourname.telegram-group-manager",
    "productName": "Telegram Group Manager",
    "copyright": "Copyright © 2024 Your Name",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "!src/**/*",
      "!**/*.ts",
      "!**/*.map",
      "!**/test/**",
      "!.env"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Telegram Group Manager"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "build/icon.png",
      "category": "Network"
    }
  }
}